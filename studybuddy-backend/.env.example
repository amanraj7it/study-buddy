# StudyBuddy Backend Configuration

# Flask & JWT
FLASK_ENV=development
FLASK_PORT=5000
JWT_SECRET_KEY=studybuddy-super-secret-key-change-in-prod

# SMTP Configuration (Gmail)
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate an "App Password" (myaccount.google.com/apppasswords)
# 3. Enter your Gmail and 16-character App Password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=StudyBuddy
SMTP_USE_TLS=true
SMTP_USE_SSL=false
